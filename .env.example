# Supabase (Python tools). SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required.
# The Next.js dashboard has its own env file: see dashboard/.env.example
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scraper Config
LOG_LEVEL=INFO
PROXY_URL=
REQUEST_DELAY=2.0
MAX_RETRIES=3
# Daily pipeline fails (non-zero exit) if fewer than this fraction of active products get a price
MIN_PRICE_COVERAGE=0.85

# Email Alerts (Phase 5)
RESEND_API_KEY=
ALERT_EMAIL=

# Drip Campaign
WHOLESALE_URL=https://kitakamicards.com
DRIP_SENDER_EMAIL=onboarding@resend.dev
