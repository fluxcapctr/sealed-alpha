# Copy to .env.local and fill in. Every variable the dashboard reads is listed here.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle: never put a secret in one.

# --- Supabase ---
# Project URL. Public. Required (src/lib/supabase/*, sitemap, API routes).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Anon key. Public by design; access is limited by RLS. Required.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key. SECRET, server-only: bypasses RLS. Used by /api/welcome-email and
# /api/unsubscribe. Never prefix with NEXT_PUBLIC_. If unset, those routes degrade
# (unsubscribe returns "service unavailable"; welcome-email skips subscriber storage).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Resend) ---
# SECRET, server-only. If unset, /api/welcome-email skips sending (dev mode).
RESEND_API_KEY=
# Sender address for the welcome email. Server-only, not secret. Must be on a domain
# verified in Resend; the default onboarding@resend.dev can only deliver to the
# Resend account owner.
DRIP_SENDER_EMAIL=onboarding@resend.dev

# --- Analytics ---
# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Public. Optional; GA is omitted if unset.
NEXT_PUBLIC_GA_ID=

# Note: WHOLESALE_URL (drip campaign link) is read by the Python drip sender
# (tools/send_drip_emails.py via config.py), not by the dashboard; set it in the repo-root .env.
